# LOCAL_ONLY=1: файл и эмбеддинги только на диске, без Pinecone/SMTP/MAX.
# Облачный ИИ для разбора при этом можно использовать: реквизиты сторон вырезаются.
LOCAL_ONLY=1
REDACT_REQUISITES=1

# LLM (DeepSeek / OpenAI). В запрос уходит текст без ИНН, счетов, адресов и названий сторон.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# Эмбеддинги: local (MiniLM) или openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# MAX-бот (опционально; веб работает без него)
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru

# Pinecone (опционально). Картотека проектов всегда локальная (data/projects).
# В Pinecone уходят только обезличенные чанки для поиска, полный договор там не хранится.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=contract-scout
PINECONE_NAMESPACE=contracts

# Веб
WEB_HOST=0.0.0.0
WEB_PORT=8080
SECRET_KEY=change-me

# Публичный адрес сервера (обязателен для ЮKassa и для ссылки «Проект договора» в MAX-боте).
# Пример: https://tcm24.store
# Без этого бот не будет отдавать ссылку на localhost — она в мессенджере не откроется.
PUBLIC_BASE_URL=
TRUST_PROXY=0
ALLOWED_HOSTS=*

# ЮKassa. Без ключей сайт работает бесплатно. PAYWALL=1 — ИИ и черновик за кредиты.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_AMOUNT=490.00
YOOKASSA_CREDITS=5
# 1 = НДС не облагается (уточните в кабинете ЮKassa / вашем налоговом режиме)
YOOKASSA_VAT_CODE=1
# 1 = email и согласие 152‑ФЗ обязательны (чек 54‑ФЗ)
YOOKASSA_REQUIRE_RECEIPT=1
PAYWALL=0

# Оператор ПДн / оферта (страницы /privacy и /offer)
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=

# Уведомления (опционально): SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=

# Логи
LOG_LEVEL=INFO
DATA_DIR=data
